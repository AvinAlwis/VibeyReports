<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>VibeyReports.FakeWorker</AssemblyName>
    <!--
      round-1 fix T2: a deterministic stand-in for the real Crystal worker so
      CrystalWorkerClientTests can exercise InvokeAsync's timeout/kill, malformed-JSON, and
      ExitCode != 0 branches without a slow, flaky dependency on the real x86 worker misbehaving
      on cue. Not part of the shipped product - referenced only from tests via VIBEY_WORKER_PATH.
    -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
