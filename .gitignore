# Build output
bin/
obj/
dist/

# User-specific
*.user
*.suo
.vs/

# NuGet
packages/
*.nupkg

# Test run artifacts (hang dumps are hundreds of MB)
TestResults/

# SDD scratch workspace (git-ignored by design; the per-task briefs are copied
# into docs/briefs/ so the reasoning behind each feature travels with the repo)
.superpowers/

# Generated report artifacts stay LOCAL. Two reasons: they are rebuilt from
# out/scripts/ on demand, and previewing one makes Crystal save live employee
# rows into the .rpt - which must not reach a git remote.
#
# The hand-made INPUTS are tracked, because nothing can rebuild them:
#   _shell_*.rpt              blank shells; _shell_overview.rpt carries the
#                             extra Details sections added in the Designer
#   Report1.rpt               the hand-made blank every shell was rebound from
#   PMSV10_IndPerfOverview.*  a colleague's report, kept as a style reference
out/**
!out/
!out/scripts/
!out/scripts/*.ps1
!out/reports/
!out/reports/_shell_*.rpt
!out/reports/Report1.rpt
!out/reports/PMSV10_IndPerfOverview*.rpt
